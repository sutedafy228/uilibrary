local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/sutedafy228/uilibrary/main/library"))()

local Window = Library:Window({
    Text = "My GUI"
})

local Tab = Window:Tab({
    Text = "Main"
})

local Section = Tab:Section({
    Text = "Main",
    Side = "Left",
    Opened = true
})

Section:Button({
    Text = "Test Button",
    Callback = function()
        print("Button clicked!")
    end
})

Section:Toggle({
    Text = "Test Toggle",
    Default = false,
    Callback = function(value)
        print("Toggle:", value)
    end
})
