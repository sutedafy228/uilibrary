--// GUI OPEN / CLOSE

local GuiVisible = true
local OpenKey = Enum.KeyCode.RightControl

function window:SetVisible(state)
    GuiVisible = state

    unnamed.Enabled = state
    shadow.Enabled = state

    if notifications then
        notifications.Enabled = state
    end
end

function window:Toggle()
    window:SetVisible(not GuiVisible)
end

function window:SetOpenKey(key)
    if typeof(key) ~= "EnumItem" then
        return
    end

    OpenKey = key
end

function window:GetOpenKey()
    return OpenKey
end


