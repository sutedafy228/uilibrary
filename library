--// THEME BUTTONS

local themesList = {
    "Dark",
    "Tokyo Night",
    "Starry Night"
}

local themeButtons = {}

local function CreateThemeButton(themeName, index)
    local button = Instance.new("TextButton")
    button.Name = themeName .. "Button"
    button.BackgroundColor3 = Theme.ItemFrame
    button.BorderSizePixel = 0
    button.Position = UDim2.new(0, 12, 0, 80 + ((index - 1) * 30))
    button.Size = UDim2.new(1, -24, 0, 25)
    button.Font = Enum.Font.GothamBold
    button.Text = themeName
    button.TextColor3 = Theme.ItemText
    button.TextSize = 11
    button.AutoButtonColor = false
    button.ZIndex = 101
    button.Parent = settingsFrame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.ItemUIStroke
    stroke.Parent = button

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 3)
    corner.Parent = button

    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = Themes[library.Theme].HoverItemFrame
    end)

    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = Themes[library.Theme].ItemFrame
    end)

    button.MouseButton1Click:Connect(function()
        if Themes[themeName] then
            library.Theme = themeName

            -- обновляем цвета основных элементов
            local NewTheme = Themes[themeName]

            main.BackgroundColor3 = NewTheme.Main
            topbar.BackgroundColor3 = NewTheme.Topbar
            tabContainer.BackgroundColor3 = NewTheme.TabContainer
            topbarLine.BackgroundColor3 = NewTheme.Lines

            settingsFrame.BackgroundColor3 = NewTheme.Main
            settingsTopbar.BackgroundColor3 = NewTheme.Topbar
            settingsTitle.TextColor3 = NewTheme.SectionText
            themeLabel.TextColor3 = NewTheme.ItemText
            settingsStroke.Color = NewTheme.MainUIStroke

            mainShadow.ImageColor3 = NewTheme.Shadow

            for _, object in ipairs(main:GetDescendants()) do

                if object.Name == "SectionFrame" then
                    object.BackgroundColor3 = NewTheme.SectionFrame

                elseif object.Name == "SectionName" then
                    object.TextColor3 = NewTheme.SectionText

                elseif object.Name == "SectionIcon" then
                    object.ImageColor3 = NewTheme.SectionText

                elseif object.Name == "ButtonFrame"
                    or object.Name == "toggleFrame"
                    or object.Name == "sliderFrame"
                    or object.Name == "inputFrame"
                    or object.Name == "dropdownFrame"
                    or object.Name == "keybindFrame" then

                    object.BackgroundColor3 = NewTheme.ItemFrame

                elseif object.Name == "ButtonText"
                    or object.Name == "toggleText"
                    or object.Name == "sliderText"
                    or object.Name == "sliderValueText"
                    or object.Name == "inputText"
                    or object.Name == "dropdownText"
                    or object.Name == "keybindText" then

                    object.TextColor3 = NewTheme.ItemText

                elseif object.Name == "buttonUIStroke"
                    or object.Name == "toggleUIStroke"
                    or object.Name == "sliderUIStroke"
                    or object.Name == "inputUIStroke"
                    or object.Name == "dropdownUIStroke"
                    or object.Name == "keybindUIStroke" then

                    object.Color = NewTheme.ItemUIStroke

                elseif object.Name == "ToggleOuter" then
                    object.BackgroundColor3 = NewTheme.ToggleOuter

                elseif object.Name == "toggleOuterUIStroke" then
                    object.Color = NewTheme.ToggleOuterUIStroke

                elseif object.Name == "toggleInner" then
                    object.ImageColor3 = NewTheme.ToggleInner

                elseif object.Name == "sliderOuter" then
                    object.BackgroundColor3 = NewTheme.SliderOuter

                elseif object.Name == "sliderInner" then
                    object.BackgroundColor3 = NewTheme.SliderInner

                elseif object.Name == "dragIcon" then
                    object.ImageColor3 = NewTheme.ItemText

                elseif object.Name == "KeybindOuter" then
                    object.BackgroundColor3 = NewTheme.ToggleOuter

                elseif object.Name == "keybindOuterUIStroke" then
                    object.Color = NewTheme.ToggleOuterUIStroke

                elseif object.Name == "TabFrame" then
                    object.BackgroundColor3 = NewTheme.TabFrame

                elseif object.Name == "TabName" then
                    object.TextColor3 = NewTheme.TabText

                elseif object.Name == "UIStroke" then
                    object.Color = NewTheme.MainUIStroke
                end
            end

            -- обновляем кнопки тем
            for _, themeButton in pairs(themeButtons) do
                themeButton.BackgroundColor3 = NewTheme.ItemFrame
                themeButton.TextColor3 = NewTheme.ItemText

                local s = themeButton:FindFirstChildOfClass("UIStroke")
                if s then
                    s.Color = NewTheme.ItemUIStroke
                end
            end

            -- обновляем цвета самой кнопки Settings
            settingsButton.ImageColor3 = NewTheme.Highlight
        end
    end)

    themeButtons[themeName] = button

    return button
end

for index, themeName in ipairs(themesList) do
    CreateThemeButton(themeName, index)
end


